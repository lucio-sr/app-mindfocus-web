# Copie para .env.local. A chave publishable é pública (vai para o navegador); o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Relatório e devolutiva: redação automática (só no servidor; nunca NEXT_PUBLIC_).
# Na Vercel: Settings → Environment Variables.
OPENAI_API_KEY=sk-...
# Opcional (padrão gpt-4o-mini, o mesmo do sistema anterior).
# OPENAI_MODEL=gpt-4o-mini
